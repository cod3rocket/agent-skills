#!/usr/bin/env bash
# PreToolUse guard for the branch flow: master <- dev <- epic/* <- feat/epic-*.
# Active only in repos that have a dev branch. Silent (zero tokens) unless it blocks.
# Opt out by starting Claude Code with RK_GUARD=0 in its environment
# (a prefix on the command itself has no effect: this hook is a separate process).
set -uo pipefail

[[ ${RK_GUARD:-1} == 0 ]] && exit 0
command -v jq >/dev/null || exit 0

input=$(cat)
cmd=$(jq -r '.tool_input.command // empty' <<<"$input")
cwd=$(jq -r '.cwd // empty' <<<"$input")
[[ $cmd == *git* || $cmd == *gh* ]] || exit 0

DEV=${RK_DEV:-dev}
MAIN=${RK_MAIN:-master}
git -C "${cwd:-.}" show-ref -q "refs/remotes/origin/$DEV" "refs/heads/$DEV" || exit 0

block() { echo "rocket flow: $* (flow: feat/epic-<name>-<phase> -> epic/<name> -> $DEV -> $MAIN; use rk)" >&2; exit 2; }

# One command per line: drop heredoc bodies, split on ; && || | and newlines,
# strip leading whitespace and VAR=value prefixes. Only command heads are checked,
# so prose in commit messages or issue bodies never matches.
segments=$(awk -v q="'" '
  hd != "" { t = $0; sub(/^[\t ]+/, "", t); if (t == hd) hd = ""; next }
  {
    line = $0
    if (match(line, "<<-?[ \t]*[\"" q "]?[A-Za-z_][A-Za-z0-9_]*[\"" q "]?")) {
      tag = substr(line, RSTART, RLENGTH)
      sub(/^<<-?[ \t]*/, "", tag); gsub("[\"" q "]", "", tag)
      hd = tag
      line = substr(line, 1, RSTART - 1) " " substr(line, RSTART + RLENGTH)
    }
    gsub(/&&|\|\||;|\|/, "\n", line)
    print line
  }' <<<"$cmd" | sed -E 's/^[[:space:]]+//; s/^([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)+//')

has() { grep -Eq "$1" <<<"$segments"; }

protected="$MAIN|main|$DEV"
GIT='^git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+'
branch=$(git -C "${cwd:-.}" branch --show-current 2>/dev/null)

if has '^gh[[:space:]]+pr[[:space:]]+(create|merge)([[:space:]]|$)'; then
  block "raw 'gh pr create/merge' is not allowed; use rk pr/finish/merge/release"
fi
if has '^gh[[:space:]]+api([[:space:]].*)?/(merges|pulls/[0-9]+/merge)([[:space:]?]|$)'; then
  block "raw merge API calls are not allowed; use 'rk sync' or 'rk merge'"
fi
if has "^gh[[:space:]]+pr[[:space:]]+edit([[:space:]].*)?(--base|-B)[[:space:]=]+($protected)([[:space:]]|$)"; then
  block "retargeting a PR to a protected branch"
fi
if has "${GIT}push([[:space:]].*)?[[:space:]:+]($protected|epic/[^[:space:]]+)([[:space:]]|$)"; then
  block "direct push to a protected or epic branch"
fi
if [[ $branch =~ ^($protected)$ || $branch == epic/* ]]; then
  if has "${GIT}(commit|merge|cherry-pick|revert|push)([[:space:]]|$)"; then
    block "no commits, merges or pushes on '$branch'; use a feature branch (rk start <issue>) or 'rk sync' for $DEV -> epic"
  fi
fi
exit 0
