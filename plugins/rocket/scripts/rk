#!/usr/bin/env bash
# shellcheck disable=SC2016 # backticks and jq \( \) are literal on purpose
# rk — GitHub epic/issue helper for the rocket skills. Terse output by design:
# every line printed here ends up in the model's context.
# Must run on bash 3.2 (macOS): no inherit_errexit, so every $(...) that
# can fail ends in '|| exit 1'.
#
# Branch flow: master <- dev <- epic/<name> <- feat/epic-<name>-<phase>
# Standalone issues: <type>/<n>-<slug> -> dev. dev -> epic via rk sync.
# Only rk release targets master, and only merges with --approved.
set -euo pipefail

R='repos/{owner}/{repo}'
DEV=${RK_DEV:-dev}
MAIN=${RK_MAIN:-master}
TMP=''
trap '[[ -n $TMP ]] && rm -rf "$TMP"' EXIT

die() { echo "rk: $*" >&2; exit 1; }

# quiet <cmd...>: run silently; on failure show its output and exit
quiet() {
  local out
  out=$("$@" 2>&1) || { echo "$out" >&2; exit 1; }
}

usage() {
  cat <<'EOF'
rk create <spec.md> [name]        epic + branch epic/<name> (from dev) + ordered sub-issues
rk add <epic> <title> [body]      new sub-issue (body: file path or text)
rk issue <title> [body]           standalone issue (goes to dev)
rk status <epic>                  progress + sub-issue list
rk next <epic>                    first open, unassigned sub-issue
rk start <issue> [feat|fix|chore] assign @me, checkout the flow branch, print issue
rk pr <issue>                     push + PR to the flow base (phase -> epic, standalone -> dev)
rk finish <epic>                  all phases closed -> PR epic/<name> -> dev
rk merge <issue> [--approved]     CI green + no conflicts -> merge, close the issue, delete the branch; dev needs --approved
rk sync <epic> [--continue|--abort]  merge dev into epic/<name> (no PR); conflicts resolved locally
rk release [title]                PR dev -> master
rk release merge --approved       merge the release PR (keeps dev)
rk clean                          delete local branches whose PR was merged + close their issue (auto on rk start)
EOF
  exit 1
}

slug() {
  printf '%s' "$1" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null | tr -d "'\"^~\`," | tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40 | sed -E 's/-+$//'
}

label() { gh label create "$1" --color "$2" >/dev/null 2>&1 || true; }

# new_issue <title> <body-file> [label] -> prints issue number
new_issue() {
  local args=(--title "$1" --body-file "$2")
  if [[ -n ${3:-} ]]; then args+=(--label "$3"); fi
  local url
  url=$(gh issue create "${args[@]}")
  echo "${url##*/}"
}

# link <parent> <child>: attach child as native sub-issue
link() {
  local id
  id=$(gh api "$R/issues/$2" --jq .id)
  gh api -X POST "$R/issues/$1/sub_issues" -F sub_issue_id="$id" >/dev/null
}

# body_file <file-or-text>: write body to $TMP/b
body_file() {
  TMP=$(mktemp -d)
  if [[ -f $1 ]]; then cp "$1" "$TMP/b"; else printf '%s\n' "$1" >"$TMP/b"; fi
}

parent_of() {
  local p
  p=$(gh api "$R/issues/$1/parent" --jq .number 2>/dev/null) || p=''
  echo "$p"
}

is_epic() { [[ $(gh issue view "$1" --json labels --jq '[.labels[].name] | index("epic") != null') == true ]]; }

# epic_branch <epic>: read "Branch: `epic/x`" from the epic body
epic_branch() {
  local b
  b=$(gh issue view "$1" --json body --jq '.body | capture("Branch: `(?<b>epic/[^`]+)`").b // empty' 2>/dev/null || true)
  [[ -n $b ]] || die "epic #$1 has no 'Branch: \`epic/...\`' line in its body"
  echo "$b"
}

# phase <epic> <issue> -> 1-based position among the epic's sub-issues
phase() {
  local p
  p=$(gh api "$R/issues/$1/sub_issues?per_page=100" --jq "[.[].number] | index($2) // empty")
  [[ -n $p ]] || die "#$2 is not a sub-issue of epic #$1"
  echo $((p + 1))
}

# flow <issue> [type] -> "branch base" for the issue's place in the flow
flow() {
  local n=$1 type=${2:-feat} e eb p
  e=$(parent_of "$n")
  if [[ -n $e ]]; then
    eb=$(epic_branch "$e") || exit 1
    p=$(phase "$e" "$n") || exit 1
    echo "feat/epic-${eb#epic/}-$p $eb"
  elif is_epic "$n"; then
    eb=$(epic_branch "$n") || exit 1
    echo "$eb $DEV"
  else
    p=$(gh issue view "$n" --json title -q .title) || exit 1
    echo "$type/$n-$(slug "$p") $DEV"
  fi
}

# Standalone branches may be feat/fix/chore; find the one that exists.
standalone_branch() {
  local n=$1 b
  b=$(git branch -a --format='%(refname:short)' | sed 's|^origin/||' | grep -E "^(feat|fix|chore)/$n-" | head -1 || true)
  echo "$b"
}

# resolve <issue> [type] -> "branch base", preferring an existing standalone branch
resolve() {
  local out branch base b
  out=$(flow "$1" "${2:-feat}") || exit 1
  read -r branch base <<<"$out"
  if [[ $base == "$DEV" && $branch != epic/* ]]; then
    b=$(standalone_branch "$1")
    if [[ -n $b ]]; then branch=$b; fi
  fi
  echo "$branch $base"
}

guard_base() {
  case $1 in master | main | "$MAIN") die "refusing to target $1: only 'rk release' goes to $MAIN" ;; esac
}

# gate <pr> <conflict-hint>: refuse unless the PR has no conflicts and every
# CI check passed. No checks at all also refuses: tests must run green in CI.
gate() {
  local pr=$1 hint=$2 i out m checks fail pend
  for i in 1 2 3 4 5; do
    out=$(gh pr view "$pr" --json mergeable,statusCheckRollup --jq '
      .mergeable, (.statusCheckRollup[] |
        (if .__typename == "CheckRun" then
           (if .status != "COMPLETED" then "pending"
            elif (.conclusion | IN("SUCCESS", "NEUTRAL", "SKIPPED")) then "ok" else "fail" end)
         else
           (if .state == "SUCCESS" then "ok" elif (.state | IN("PENDING", "EXPECTED")) then "pending" else "fail" end)
         end) + "\t" + (.name // .context))') || exit 1
    m=${out%%$'\n'*}
    [[ $m == UNKNOWN ]] || break
    sleep 3
  done
  [[ $m != CONFLICTING ]] || die "PR #$pr has conflicts: $hint, then retry"
  [[ $m == MERGEABLE ]] || die "PR #$pr mergeability is $m; retry in a moment"
  checks=$(sed 1d <<<"$out")
  [[ -n $checks ]] || die "PR #$pr has no CI checks; tests must pass in CI before merging"
  fail=$(awk -F'\t' '$1 == "fail" { printf "%s; ", $2 }' <<<"$checks")
  [[ -z $fail ]] || die "PR #$pr failing checks: ${fail%; } (gh pr checks $pr)"
  pend=$(awk -F'\t' '$1 == "pending" { printf "%s; ", $2 }' <<<"$checks")
  [[ -z $pend ]] || die "PR #$pr checks still running: ${pend%; } (gh pr checks $pr --watch, then retry)"
}

cmd_create() {
  local spec=${1:-} name=${2:-}
  [[ -f $spec ]] || die "spec not found: $spec"
  TMP=$(mktemp -d)
  # "# Title" = epic, "## Task: Title" = sub-issue; everything else is body.
  awk -v d="$TMP" '
    /^# / && !e      { e = 1; print substr($0, 3) > (d "/0.t"); f = d "/0.b"; printf "" > f; next }
    /^## Task: /     { n++; print substr($0, 10) > (d "/" n ".t"); f = d "/" n ".b"; printf "" > f; next }
    f                { print > f }
  ' "$spec"
  [[ -f $TMP/0.t ]] || die "spec needs a '# Epic title' line"
  [[ -f $TMP/1.t ]] || die "spec needs at least one '## Task: title' line"

  local branch sha
  branch="epic/$(slug "${name:-$(<"$TMP/0.t")}")"
  sha=$(gh api "$R/git/ref/heads/$DEV" --jq .object.sha) || die "base branch '$DEV' not found"
  gh api -X POST "$R/git/refs" -f ref="refs/heads/$branch" -f sha="$sha" >/dev/null ||
    die "could not create $branch (already exists?)"
  printf '\nBranch: `%s`\n' "$branch" >>"$TMP/0.b"

  label epic 5319E7
  local epic i=1 n
  epic=$(new_issue "$(<"$TMP/0.t")" "$TMP/0.b" epic)
  echo "epic #$epic $(<"$TMP/0.t") [$branch]"
  while [[ -f $TMP/$i.t ]]; do
    n=$(new_issue "$(<"$TMP/$i.t")" "$TMP/$i.b")
    link "$epic" "$n"
    echo "  $i. #$n $(<"$TMP/$i.t")"
    i=$((i + 1))
  done
}

cmd_add() {
  local epic=${1:-} title=${2:-} n
  [[ -n $epic && -n $title ]] || usage
  body_file "${3:-}"
  n=$(new_issue "$title" "$TMP/b")
  link "$epic" "$n"
  echo "#$n $title -> epic #$epic"
}

cmd_issue() {
  local title=${1:-} n
  [[ -n $title ]] || usage
  body_file "${2:-}"
  n=$(new_issue "$title" "$TMP/b")
  echo "#$n $title"
}

cmd_status() {
  local e=${1:-}
  [[ -n $e ]] || usage
  gh issue view "$e" --json title --jq '"epic #'"$e"' \(.title):"' | tr '\n' ' '
  gh api "$R/issues/$e/sub_issues?per_page=100" --jq '
    "\(map(select(.state == "closed")) | length)/\(length) done",
    (to_entries[] | .key as $i | .value
     | "  \($i + 1). \(if .state == "closed" then "[x]" else "[ ]" end) #\(.number) \(.title)\(if .assignee then " @" + .assignee.login else "" end)")'
}

cmd_next() {
  local e=${1:-} out
  [[ -n $e ]] || usage
  out=$(gh api "$R/issues/$e/sub_issues?per_page=100" \
    --jq '[.[] | select(.state == "open" and .assignee == null)][0] // empty | "#\(.number) \(.title)"')
  echo "${out:-none: every sub-issue is closed or assigned}"
}

# Delete local branches whose remote is gone and whose PR was merged; close the
# issue the PR names ("Closes #n" only auto-closes on the default branch).
cmd_clean() {
  local cur b pr i n=0
  git fetch -q --prune origin
  cur=$(git branch --show-current)
  while read -r b; do
    [[ $b == "$cur" ]] && continue
    pr=$(gh pr list --head "$b" --state merged --json number,body \
      --jq '.[0] // empty | "\(.number) \((.body | capture("Closes #(?<n>[0-9]+)").n) // "")"') || continue
    [[ -n $pr ]] || continue
    git branch -q -D "$b" && n=$((n + 1))
    i=${pr#* }
    if [[ -n $i && $(gh issue view "$i" --json state -q .state) == OPEN ]]; then
      quiet gh issue close "$i" --comment "Merged via #${pr%% *}."
      echo "closed #$i"
    fi
  done < <(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2 == "[gone]" { print $1 }')
  if ((n)); then echo "cleaned $n merged branch(es)"; fi
}

cmd_start() {
  local n=${1:-} kind out branch base e p open behind
  [[ -n $n ]] || usage
  kind=$(gh api "$R/issues/$n" --jq 'if .pull_request then "pr" elif ([.labels[].name] | index("epic")) then "epic" else "issue" end') || exit 1
  case $kind in
    pr) die "#$n is a pull request, not an issue" ;;
    epic) die "#$n is an epic; work its sub-issues (rk next $n)" ;;
  esac
  cmd_clean
  out=$(resolve "$n" "${2:-feat}") || exit 1
  read -r branch base <<<"$out"
  guard_base "$base"
  quiet gh issue edit "$n" --add-assignee @me
  if ! gh issue develop "$n" --name "$branch" --base "$base" --checkout >/dev/null 2>&1; then
    # Branch already exists: reuse it.
    if git show-ref -q --verify "refs/heads/$branch"; then
      git checkout -q "$branch"
    else
      git checkout -q -b "$branch" --track "origin/$branch" 2>/dev/null ||
        git checkout -q -b "$branch" "origin/$base" || die "could not checkout $branch (dirty tree?)"
    fi
  fi
  echo "branch: $branch -> $base"
  e=$(parent_of "$n")
  if [[ -n $e ]]; then
    p=$(phase "$e" "$n") || exit 1
    echo "epic: #$e phase $p"
    behind=$(git rev-list --count "origin/${base}..origin/$DEV" 2>/dev/null || echo 0)
    if ((behind)); then echo "warn: $base is $behind commit(s) behind $DEV (rk sync $e)"; fi
    open=$(gh api "$R/issues/$e/sub_issues?per_page=100" \
      --jq ".[:$((p - 1))] | map(select(.state == \"open\") | \"#\(.number)\") | join(\" \")")
    if [[ -n $open ]]; then echo "warn: earlier phases still open: $open"; fi
  fi
  gh issue view "$n" --json number,title,body,comments --jq '
    "#\(.number) \(.title)\n\n\(.body)"
    + (if (.comments | length) > 0
       then "\n\n--- \(.comments | length) comment(s), latest:\n\(.comments[-1].body)"
       else "" end)'
}

cmd_pr() {
  local n=${1:-} out branch base title body
  [[ -n $n ]] || usage
  out=$(resolve "$n") || exit 1
  read -r branch base <<<"$out"
  guard_base "$base"
  [[ $(git branch --show-current) == "$branch" ]] || die "not on $branch (rk start $n first)"
  title=$(gh issue view "$n" --json title -q .title)
  git push -q -u origin HEAD
  body="Closes #$n"$'\n\n'"$(git log --reverse --format='- %s' "origin/$base..HEAD")"
  gh pr create --base "$base" --head "$branch" --title "$title" --body "$body"
}

cmd_finish() {
  local e=${1:-} branch open list
  [[ -n $e ]] || usage
  branch=$(epic_branch "$e") || exit 1
  open=$(gh api "$R/issues/$e/sub_issues?per_page=100" --jq 'map(select(.state == "open") | "#\(.number)") | join(" ")')
  [[ -z $open ]] || die "phases still open: $open"
  list=$(gh api "$R/issues/$e/sub_issues?per_page=100" --jq '.[] | "- #\(.number) \(.title)"')
  gh pr create --base "$DEV" --head "$branch" \
    --title "$(gh issue view "$e" --json title -q .title)" \
    --body "Closes #$e"$'\n\n'"$list"
}

cmd_merge() {
  local n=${1:-} approved=${2:-} out branch base pr how
  [[ -n $n ]] || usage
  out=$(resolve "$n") || exit 1
  read -r branch base <<<"$out"
  guard_base "$base"
  if [[ $base == "$DEV" && $approved != --approved ]]; then
    die "merging into $DEV needs the user's explicit approval: rk merge $n --approved"
  fi
  pr=$(gh pr list --head "$branch" --base "$base" --state open --json number --jq '.[0].number // empty')
  [[ -n $pr ]] || die "no open PR $branch -> $base (rk pr $n / rk finish $n)"
  # Phases and standalone issues squash; an epic keeps its phase commits.
  if [[ $branch == epic/* ]]; then
    how=--merge
    gate "$pr" "rk sync $n, resolve, rk sync $n --continue"
  else
    how=--squash
    gate "$pr" "on $branch run git merge origin/$base, resolve, commit, git push"
  fi
  quiet gh pr merge "$pr" "$how" --delete-branch
  if [[ $(gh issue view "$n" --json state -q .state) == OPEN ]]; then
    quiet gh issue close "$n" --comment "Merged via #$pr into \`$base\`."
  fi
  { git checkout -q "$base" && git pull -q --ff-only && git fetch -q --prune; } 2>/dev/null || true
  echo "merged #$pr $branch -> $base; #$n closed"
}

# Merge dev into the epic branch. Server-side when clean; on conflict, merge
# locally and leave the conflicts for the agent (--continue / --abort).
cmd_sync() {
  local e=${1:-} opt=${2:-} branch code files
  [[ -n $e ]] || usage
  branch=$(epic_branch "$e") || exit 1
  case $opt in
    --continue)
      [[ $(git branch --show-current) == "$branch" ]] || die "not on $branch"
      files=$(git diff --name-only --diff-filter=U)
      [[ -z $files ]] || die "still unresolved: $(echo "$files" | tr '\n' ' ')(git add them)"
      quiet git commit --no-edit
      quiet git push origin "$branch"
      echo "synced $DEV -> $branch"
      return ;;
    --abort)
      git merge --abort 2>/dev/null || true
      echo "sync aborted; $branch unchanged"
      return ;;
  esac
  code=$(gh api -i -X POST "$R/merges" -f base="$branch" -f head="$DEV" \
    -f commit_message="chore: merge $DEV into $branch" 2>/dev/null | awk 'NR == 1 { print $2; exit }') || true
  case $code in
    201) echo "synced $DEV -> $branch" ;;
    204) echo "$branch already has $DEV" ;;
    409)
      git fetch -q origin
      if git show-ref -q --verify "refs/heads/$branch"; then
        quiet git checkout "$branch"
        quiet git merge --ff-only "origin/$branch"
      else
        quiet git checkout -b "$branch" --track "origin/$branch"
      fi
      if git merge -q --no-edit -m "chore: merge $DEV into $branch" "origin/$DEV" >/dev/null 2>&1; then
        quiet git push origin "$branch"
        echo "synced $DEV -> $branch"
      else
        echo "conflicts merging $DEV into $branch:"
        git diff --name-only --diff-filter=U | sed 's/^/  /'
        echo "resolve them, git add, then: rk sync $e --continue (or --abort)"
      fi ;;
    *) die "merge API failed (HTTP ${code:-?}) for $DEV -> $branch" ;;
  esac
}

cmd_release() {
  local sub=${1:-} approved=${2:-} pr list
  pr=$(gh pr list --head "$DEV" --base "$MAIN" --state open --json number --jq '.[0].number // empty')
  if [[ $sub == merge ]]; then
    [[ $approved == --approved ]] || die "merging into $MAIN needs the user's explicit approval: rk release merge --approved"
    [[ -n $pr ]] || die "no open PR $DEV -> $MAIN (rk release)"
    gate "$pr" "merge origin/$MAIN into a branch off $DEV and land it via a PR"
    quiet gh pr merge "$pr" --merge
    echo "merged #$pr $DEV -> $MAIN"
    return
  fi
  if [[ -n $pr ]]; then gh pr view "$pr" --json url -q .url; return; fi
  git fetch -q origin
  list=$(git log --first-parent --format='- %s' "origin/$MAIN..origin/$DEV")
  [[ -n $list ]] || die "$DEV has nothing new for $MAIN"
  gh pr create --base "$MAIN" --head "$DEV" --title "${sub:-Release $(date +%F)}" --body "$list"
}

cmd=${1:-}
shift || true
case $cmd in
  create | add | issue | status | next | start | pr | finish | merge | clean | sync | release) "cmd_$cmd" "$@" ;;
  *) usage ;;
esac
